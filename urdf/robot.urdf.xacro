<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jga25_robot">
  
  <!-- 1. On inclut votre configuration ros2_control -->
  <xacro:include filename="ros2_control.xacro" />

  <!-- 2. Définition des liens (base) -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!-- 3. Définition du joint (la roue) -->
  <joint name="roue_joint" type="continuous">
    <parent link="base_link"/>
    <child link="roue_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- Axe de rotation de la roue -->
  </joint>

  <!-- 4. Définition du lien de la roue -->
  <link name="roue_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

</robot>